// PostgreSQL / Supabase / Neon Production Schema for DineFlow
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
  KITCHEN_STAFF
}

enum SpiceLevel {
  MILD
  MEDIUM
  SPICY
  VERY_SPICY
}

enum DietaryTag {
  VEG
  NON_VEG
  VEGAN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLING
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  SENT_TO_KITCHEN
  PREPARING
  READY
  SERVED
  BILLED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  SPLIT
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  role      UserRole  @default(CASHIER)
  pin       String    @default("1234")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  icon      String     @default("Utensils")
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id              String      @id @default(uuid())
  name            String
  description     String
  price           Float
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  spiceLevel      SpiceLevel  @default(MEDIUM)
  dietaryTag      DietaryTag  @default(NON_VEG)
  prepTimeMinutes Int         @default(15)
  isAvailable     Boolean     @default(true)
  imageUrl        String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
}

model Table {
  id             String      @id @default(uuid())
  number         Int         @unique
  name           String
  capacity       Int         @default(4)
  status         TableStatus @default(AVAILABLE)
  currentOrderId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orders         Order[]
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  orderType      OrderType     @default(DINE_IN)
  status         OrderStatus   @default(PENDING)
  tableId        String?
  table          Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subtotal       Float         @default(0.0)
  taxAmount      Float         @default(0.0)
  discountAmount Float         @default(0.0)
  finalAmount    Float         @default(0.0)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  PaymentMethod?
  specialNotes   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          OrderItem[]
  invoice        Invoice?

  @@index([status])
  @@index([tableId])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id])
  quantity        Int             @default(1)
  unitPrice       Float
  spicePreference SpiceLevel?
  notes           String?
  status          OrderItemStatus @default(PENDING)
  createdAt       DateTime        @default(now())

  @@index([orderId])
  @@index([menuItemId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subtotal      Float
  cgst          Float
  sgst          Float
  totalAmount   Float
  paymentMethod PaymentMethod
  splitDetails  String?
  customerName  String?       @default("Guest")
  customerPhone String?
  createdAt     DateTime      @default(now())

  @@index([invoiceNumber])
  @@index([createdAt])
}
